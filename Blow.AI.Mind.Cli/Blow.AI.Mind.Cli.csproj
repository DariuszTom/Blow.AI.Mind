<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>blow-ai-mind</ToolCommandName>
    <ApplicationIcon>..\assets\icon.ico</ApplicationIcon>
    <PackageId>Blow.AI.Mind.Cli</PackageId>
    <Description>Command line tool generating fictional Excel workbooks with prompt-injection scenarios and encryption.</Description>
    <PackageTags>excel;xlsx;fake-data;prompt-injection;ai;testing;llm;security;dotnet-tool</PackageTags>

    <!-- Package size: English-only satellite resources, no XML docs from referenced assemblies, embedded PDB. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blow.AI.Mind\Blow.AI.Mind.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
