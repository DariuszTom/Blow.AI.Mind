{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blow.AI.Mind injection definition",
  "type": "object",
  "required": [ "id", "category", "text" ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "category": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "language": { "type": "string", "default": "en" },
    "text": {
      "type": "string",
      "pattern": "\\{\\{(marker|beacon)\\}\\}",
      "description": "{{marker}} is replaced by a unique canary marker; {{beacon}} by a unique URL on the beacon host configured with WithBeacon()."
    },
    "placements": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": [ "Cell", "Comment", "HiddenCell", "HiddenSheet", "DocumentProperties", "DefinedName" ] },
      "default": [ "Cell", "Comment", "HiddenCell", "HiddenSheet", "DocumentProperties", "DefinedName" ]
    },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}
